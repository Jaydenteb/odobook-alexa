{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odobook-alexa",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // The canonical public URL (the MCP resource is PUBLIC_URL + "/mcp"). Set to the workers.dev
    // URL after the first deploy; .dev.vars overrides it for local runs.
    "PUBLIC_URL": "https://odobook-alexa.odobook-alexa.workers.dev"
  },
  // Run the Worker next to the database: a tool call makes several D1 queries, so this keeps each
  // call to one long-haul round trip, wherever the caller is.
  "placement": { "mode": "smart" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "3910cf1f4fc644fda6e3649c41b472c3" }],
  "d1_databases": [{ "binding": "DB", "database_name": "odobook", "database_id": "dca55465-dcc2-4492-b4a1-b69774d3fea6" }]
}
